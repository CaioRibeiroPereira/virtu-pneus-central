{
  "id": "vitoTelegramExtracao1",
  "name": "Vito — conversas do Telegram para a extração",
  "nodes": [
    {
      "id": "c3f2e4a5-0001-4c1a-9b10-000000000001",
      "name": "A cada minuto",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "c3f2e4a5-0002-4c1a-9b10-000000000002",
      "name": "Conversas prontas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vitoAgentToken01",
          "name": "Sistema Virtù (Bearer)"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.VITO_APP_URL || 'http://host.docker.internal:3000') + '/api/telegram/conversas' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "c3f2e4a5-0003-4c1a-9b10-000000000003",
      "name": "Uma conversa por item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "return ($input.first().json.conversas || []).map((c) => ({ json: c }));"
      }
    },
    {
      "id": "c3f2e4a5-0004-4c1a-9b10-000000000004",
      "name": "Enviar à extração",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/vito-conversa",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, conversation_id: $json.conversation_id, message_ids: $json.message_ids, messages: $json.messages }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "c3f2e4a5-0005-4c1a-9b10-000000000005",
      "name": "Marcar como extraída",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "vitoAgentToken01",
          "name": "Sistema Virtù (Bearer)"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.VITO_APP_URL || 'http://host.docker.internal:3000') + '/api/telegram/conversas/' + $('Uma conversa por item').item.json.chat_id + '/extraida' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ate: $('Uma conversa por item').item.json.ate }) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "A cada minuto": {
      "main": [
        [
          {
            "node": "Conversas prontas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Conversas prontas": {
      "main": [
        [
          {
            "node": "Uma conversa por item",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Uma conversa por item": {
      "main": [
        [
          {
            "node": "Enviar à extração",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar à extração": {
      "main": [
        [
          {
            "node": "Marcar como extraída",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo"
  },
  "pinData": {}
}
