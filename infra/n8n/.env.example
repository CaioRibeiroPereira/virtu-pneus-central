# Copie para infra/n8n/.env (não versionado). As CHAVES não ficam aqui: vão em credenciais do n8n.

# Provedor padrão quando a conversa não diz qual usar: gemini | ollama
VITO_PROVIDER=gemini
VITO_GEMINI_MODEL=gemini-3.5-flash
VITO_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
VITO_OLLAMA_MODEL=llama3.2:3b
# Ollama rodando no computador (fora do container)
VITO_OLLAMA_URL=http://host.docker.internal:11434
# Sistema que recebe os eventos: local (npm run dev) ou a demonstração na Vercel
VITO_APP_URL=http://host.docker.internal:3000
