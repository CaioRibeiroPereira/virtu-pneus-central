# Copie este arquivo para .env.local e preencha. Nunca versione o .env.local.

# Connection string do Neon (versão "pooled", com -pooler no host)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Usadas a partir da Fase 2 (login do gestor e endpoint dos agentes)
GESTOR_PASSWORD=
SESSION_SECRET=
AGENT_API_TOKEN=

# Regras de negócio
APP_TIMEZONE=America/Sao_Paulo
AGENT_AUTO_APPLY_THRESHOLD=0.85

# IA (D42): usadas pelo banco de testes de extração e pelo workflow do n8n
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
